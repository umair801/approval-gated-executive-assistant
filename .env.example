# ---- Runtime ----
APP_ENV=development                # development | production
PORT=8000

# ---- Access control (pick ONE mode) ----
# Private mode: set ACCESS_TOKEN. Login required, single user, real data allowed.
ACCESS_TOKEN=
# Public demo mode: no token, sample data only, one sandbox per visitor.
ALLOW_PUBLIC_DEMO=false
# Token that the Railway cron job sends to POST /api/jobs/briefing
CRON_TOKEN=

# ---- Data source ----
DATA_MODE=sample                   # sample | google

# ---- Claude (leave empty to use the built-in deterministic mock) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Set from your current price list to get cost per briefing in metrics (USD per 1M tokens)
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
DAILY_LLM_CALL_CAP=300

# ---- Supabase / PostgreSQL (leave empty for in-memory store) ----
DATABASE_URL=
# Shared Supabase project: prefix for every table and index, normally your subdomain, e.g. assistant
TABLE_PREFIX=

# ---- Secrets ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Google (read-only scopes) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Restaurants (optional, sample data is used when empty) ----
PLACES_API_KEY=

# ---- Scheduler ----
TIMEZONE=Asia/Shanghai
BRIEFING_ENABLED=false
BRIEFING_TIME=07:30
APPROVAL_TTL_HOURS=24
RATE_LIMIT_PER_MIN=30
